# Copie este arquivo com o nome .env.local e preencha só o que for usar.
# Sem nada preenchido o sistema funciona em modo local (dados na pasta "dados").

# Leitura automática da planta (API do Claude). Opcional.
ANTHROPIC_API_KEY=

# Banco na nuvem (Supabase). Opcional. Preencha as duas linhas juntas.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Só se o LibreOffice estiver instalado em um lugar diferente do padrão.
SOFFICE_PATH=
